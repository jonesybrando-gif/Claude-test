# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# Secret used to sign session cookies (openssl rand -base64 32)
AUTH_SECRET=""
# 32-byte base64 key for encrypting OAuth tokens at rest (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=""
# Public base URL of the app; must match the OAuth redirect URI registered with Google
APP_URL="http://localhost:3000"
# Shared secret for the scheduled sync endpoint (/api/cron/sync); at least 16 characters
CRON_SECRET=""

# Google Ads API (see docs/google-ads-setup.md)
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
# GOOGLE_ADS_API_VERSION="v26"

# Meta Ads (see docs/meta-ads-setup.md)
META_APP_ID=""
META_APP_SECRET=""
# META_GRAPH_API_VERSION="v26.0"

# Microsoft Advertising (see docs/microsoft-ads-setup.md)
MICROSOFT_ADS_CLIENT_ID=""
MICROSOFT_ADS_CLIENT_SECRET=""
MICROSOFT_ADS_DEVELOPER_TOKEN=""
# MICROSOFT_ADS_TENANT="common"
